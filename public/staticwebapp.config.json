{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/orbit/*", "/auth-redirect.html", "/*.{png,jpg,jpeg,gif,svg,ico,webp,css,js,map,json,txt,woff,woff2}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  }
}
