# Microsoft sign-in (optional). Leave blank in the local build: the Microsoft button then
# shows an honest "not configured" message and no tenant is ever contacted.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
# Leave blank to use <this site>/auth-redirect.html (a static return page for the sign-in popup). Register that URL in Entra.
VITE_ENTRA_REDIRECT_URI=

# Address of the API when it is NOT served under /api on this site (for example a separate Azure web app). No trailing slash, no /api.
# Leave blank for local development: calls go to /api and the dev server proxies them.
VITE_API_BASE_URL=
